---
import '../styles/main.css';

import Preview from '../components/Preview.astro';
import Navigation from '../components/Navigation.astro';

const allPosts = Object.values(
  import.meta.glob('./posts/*.md', { eager: true }),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jake Wilson</title>
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <div>
        <h1><a href="/">Jake Wilson</a></h1>
        <Navigation />
      </div>
      <section id="about">
        <p>
          I used to write; now I cod<span id="cursor">e</span>
        </p>
        <p>
          Take a look at my work on <a href="https://github.com/jkwlsn"
            >GitHub</a
          >, bring me onboard as an open-source contributor, or meet me for a
          coffee: <a href="mailto:hi@jkwlsn.dev">hi@jkwlsn.dev</a>.
        </p>
      </section>
    </header>
    <main>
      <section id="blog">
        <ol>
          {
            allPosts.map((post: any) => (
              <li>
                <Preview
                  url={post.url}
                  title={post.frontmatter.title}
                  pubDate={post.frontmatter.pubDate}
                  standfirst={post.frontmatter.standfirst}
                />
              </li>
            ))
          }
        </ol>
      </section>
    </main>
  </body>
</html>
