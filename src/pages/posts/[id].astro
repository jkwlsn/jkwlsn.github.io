---
import { getCollection, render } from 'astro:content';
import Preview from '../../components/Preview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => (
    {
      params: { id: post.id },
      props: { post },
    }
  ));
}

const { post } = Astro.props;
const { Content } = await render(post);

const {title} = post.data;
const {description} = post.data;
const keywords = post.data.tags ? post.data.tags.join(", ") : undefined;
---

<BaseLayout title={title} description={description} keywords={keywords} type="BlogPosting" publishDate={post.data.date} updatedDate={post.data.updatedDate}>
  <article class="post-layout">
    <header>
      <Preview post={post} />
    </header>
    <section><Content /></section>
  </article>
</BaseLayout>
