---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { siteConfig } from "../config";
import "@styles/main.css";
import OpenGraph from "@components//OpenGraph.astro";
import JsonLd from "@components/JsonLd.astro";

export interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    canonicalURL?: string;
    type?: "WebSite" | "BlogPosting";
    publishDate?: Date;
    updatedDate?: Date;
}

const {
    title: pageTitle,
    description = siteConfig.description,
    keywords: pageKeywords,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    type = "WebSite",
    publishDate,
    updatedDate,
} = Astro.props;

const title = (() => {
    if (pageTitle) return `${pageTitle} - ${siteConfig.title}`;
    if (description) return `${siteConfig.title} - ${description}`;
    return siteConfig.title;
})();

const rawKeywords = [
    ...(pageKeywords ? pageKeywords.split(",") : []),
    ...(siteConfig.keywords ? siteConfig.keywords.split(",") : []),
];

const keywords = [
    ...new Set(rawKeywords.map((k) => k.trim().toLowerCase()).filter(Boolean)),
]
    .toSorted((a, b) => a.localeCompare(b))
    .join(", ");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonicalURL} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<script src="/src/pwa.ts"></script>
<ClientRouter />
<Font cssVariable="--font-instrument-serif" preload />
<Font cssVariable="--font-plex-mono-regular" preload />
<link
    rel="alternate"
    type="application/rss+xml"
    title="Jake Wilson's Posts"
    href={new URL("rss.xml", Astro.site)}
/>
<OpenGraph ogTitle={title} ogDescription={description} ogUrl={canonicalURL} />
<JsonLd
    type={type}
    title={pageTitle}
    description={description}
    publishDate={publishDate}
    updatedDate={updatedDate}
    url={canonicalURL}
/>
