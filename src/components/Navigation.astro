---
import { nav } from '../config';
import type { NavItem } from '../config';
---

<nav class="navigation-component">
    <ul>
        {nav.map((item: NavItem) => (
            <li>
                <a rel={item.rel} title={item.title} href={item.link}>
                    {item.text}
                </a>
            </li>
        ))}
    </ul>
</nav>
