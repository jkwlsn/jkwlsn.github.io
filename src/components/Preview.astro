---
const { title, url, pubDate, standfirst } = Astro.props;
---

<div>
  <h1>
    <a href={url} title={title}>
      {title}
    </a>
  </h1>
  <time>{pubDate}</time>
  <p>{standfirst}</p>
</div>

<style>
  h1,
  h2,
  h3 {
    font-family: var(--display-serif-fonts);
    font-size: 3em;
  }

  div {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;

    h1 {
      margin-top: 0.5rem;
      margin-bottom: 1rem;
    }

    p {
      margin-top: 0;
      font-family: var(--body-serif-fonts);
    }

    time {
      order: -1;
      font-size: 1rem;
    }
  }
</style>
