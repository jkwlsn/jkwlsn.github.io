---
const { title, url, pubDate, standfirst } = Astro.props;
---

<div>
  <h1>
    <a href={url} title={title}>
      {title}
    </a>
  </h1>
  <time>{pubDate}</time>
  <p>{standfirst}</p>
</div>

<style>
  div {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;

    h1,
    h2 {
      font-family: var(--display-serif-fonts);
    }

    h1 {
      font-size: 3rem;
      margin-block: 0.25em;
    }

    p {
      font-family: var(--body-serif-fonts);
    }

    time {
      order: -1;
      font-family: var(--body-mono-fonts);
      font-size: 0.6em;
    }
  }
</style>
