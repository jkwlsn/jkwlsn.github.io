---
const { post } = Astro.props;

const options: Intl.DateTimeFormatOptions = {
  hour12: false,
  dateStyle: 'full',
  // timeStyle: 'long',
  // timeZone: 'Europe/London',
  // hour: 'numeric',
  // minute: 'numeric',
  // day: 'numeric',
  // weekday: 'long',
  // month: 'long',
  // year: 'numeric',
  // timeZoneName: 'long',
  //  era: 'long',
};

const displayDate = new Intl.DateTimeFormat(undefined, options).format(
  post.data.pubDate,
);
---

<div class="preview-component">
  <h1>
    <a href={`/posts/${post.id}`} title={post.data.title}>
      {post.data.title}
    </a>
  </h1>
  <time>{displayDate}</time>
  <p>{post.data.description}</p>
</div>
