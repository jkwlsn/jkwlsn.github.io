---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <Head />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }

  main {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    padding: 3em 1em 1em 1em;

    article,
    section {
      grid-column: 1 / -1;
    }
  }
</style>
